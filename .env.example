# Ghost site + API credentials
# Get yours: Ghost admin panel -> Integrations
#   - Admin API  -> create a new admin key (full read/write)
#   - Content API -> create a new content key (read-only)
GHOST_URL=https://your-ghost-site.example
GHOST_ADMIN_KEY=<key id>:<64-char-hex-secret>
# Optional: GHOST_CONTENT_KEY — with only this set (no GHOST_ADMIN_KEY),
# the server runs in read-only mode
GHOST_CONTENT_KEY=

# Optional: MCP_TRANSPORT=stdio|streamable-http|sse (default: stdio)
# Optional: PORT=8000

# HTTP-surface auth (streamable-http / sse only):
# The server binds 127.0.0.1 by default. To bind another address, set HOST,
# and that REQUIRES MCP_AUTH_TOKEN — the server refuses to start on a
# non-loopback bind without a token. With a token set, every MCP HTTP request
# must carry:  Authorization: Bearer <MCP_AUTH_TOKEN>
#HOST=0.0.0.0
#MCP_AUTH_TOKEN=
